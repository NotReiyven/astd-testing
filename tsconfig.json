{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type checking — incremental strict rollout.
       strictNullChecks and noImplicitAny are the two highest-impact strict
       flags and are enabled first. Once the codebase is clean under these,
       enable the remaining flags (strictFunctionTypes, strictPropertyInitialization,
       strictBindCallApply, useUnknownInCatchVariables) one at a time, then
       flip `strict: true` for the full set. */
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "scripts/images.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}