{
  "name": "astd-value-list",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "fetch-images": "node scripts/fetch-images.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:rls": "node scripts/check-rls.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:rls && npm run typecheck && npm run lint && npm run test:run && npm run build && npm run check:secrets"
  },
  "dependencies": {
    "@sentry/react": "^11.4.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.51.11",
    "@tanstack/react-virtual": "^3.14.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.1.6",
    "framer-motion": "^11.11.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "1.3.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.1",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}